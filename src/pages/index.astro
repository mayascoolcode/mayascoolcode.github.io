			display: flex;
			flex-direction: column;
			height: 100dvh;
			justify-content: space-between;
			background-image: url(https://i.pinimg.com/736x/49/57/80/4957807b27f89473bd6fff834d3b7e95.jpg);
			background-attachment: fixed;
  			overflow: hidden;
		}
	</style>
	<header class="px-2">
		<h1>mmdungeon.xyz</h1>
	</header>
	<main>
		<Link navlink='Mortal' link="/mortal/" img="https://i.pinimg.com/originals/21/b1/8e/21b18e36c3b8cd598ddde91d8e619634.gif" position='left: 20vw; top: 18vw; width: 15vw;'/>	
	</main>
	<footer class="flex flex-col gap absolute bottom-2 right-4 justify-center">
		<a href="https://mmdungeon.atabook.org/" target="_blank" rel="noopener noreferrer"> <script language="javascript" type="text/javascript" src="//counter1.fc2.com/counter.php?id=40502263&main=1"></script><noscript><img src="//counter1.fc2.com/counter_img.php?id=40502263&main=1" /></noscript> </a>
