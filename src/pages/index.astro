---
import Home from '../layouts/Home.astro';
import { Image } from 'astro:assets';
import selfinsertwebring from "../assets/lib/js/selfinsertwebring.js";

const collection = import.meta.glob<{ default: ImageMetadata }>("../assets/img/collection/*/*", { eager: true });
const c = Object.values(collection).map(module => module.default);
---
<style>
    #Collection img {
        display: inline;
    }
    .tabcontent {
        display: none;
    }
    .tabcontent {
        animation: fadeEffect 1s;
    }
    @keyframes fadeEffect {
        from {opacity: 0;}
        to {opacity: 1;}
    }
</style>
<Home title='Index'>
	<section class="text-right">
        <button class="tablinks" onclick="openTab(event, 'Home')" id="defaultOpen">Home</button>
        <button class="tablinks" onclick="openTab(event, 'About')">About</button>
        <button class="tablinks" onclick="openTab(event, 'Collection')">Collection</button>
    </section>

	<section id="Home" class="text-center tabcontent">
		<p>Welcome to the dungeon. <br> <em>This site contains suggestive content.</em> </p>
		<script type="text/javascript" src="//counter1.fc2.com/counter.php?id=40502263&main=1"></script><noscript><img src="//counter1.fc2.com/counter_img.php?id=40502263&main=1" /></noscript>
		<iframe src="https://www3.cbox.ws/box/?boxid=3555384&boxtag=45aUsY" width="100%" height="450" allowtransparency="yes" allow="autoplay" frameborder="0" marginheight="0" marginwidth="0" scrolling="auto"></iframe>		
	</section>

	<section id="About" class="text-center tabcontent">
        <a href="https://www.imood.com/users/mortalmutt"><img src="https://moods.imood.com/display/uname-mortalmutt/fg-FFFFFF/trans-1/imood.gif" alt="The current mood of mortalmutt at www.imood.com" border="0" class="m-auto"></a>
        <p> 22, they/them <br> I make furry girls & cute beats.</p>
        <div class="flex gap-3 justify-center">
            <a href="/about/gf/lock/"><img src="" alt="<3"></a>
        </div>
    </section>

    <section id="Collection" class="text-center tabcontent">
        <a href="https://cinni.net/" target="_blank" rel="noopener noreferrer"><img src="https://cinni.net/images/button/cinni_angelbutton3.gif" alt=""></a>
        <a href="https://grossgirl94.neocities.org/" target="_blank" rel="noopener noreferrer"><img src="https://grossgirl94.neocities.org/photos/grossgirl94%20button%20transparent.gif" alt=""></a>
        {c.map((c) => (<Image src={c} alt="collection item" loading="lazy"/>))}
        <div id="selfinsertwebring">
