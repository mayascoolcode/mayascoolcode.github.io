---
import Layout from '../../../layouts/Layout.astro';
import Back from '../../../layouts/elements/Back.astro';
import { Image } from "astro:assets";

const photos = import.meta.glob<{ default: ImageMetadata }>("../../../assets/img/photos/*", { eager: true });
const p = Object.values(photos).map(module => module.default);
---
<Layout title="Photos">
	<section id="Photos" class="grid grid-cols-4" id="photos">
		{p.map((p) => (<Image src={p} alt="photo" loading="lazy"/>))}
	</section>
	<Back/>
</Layout>