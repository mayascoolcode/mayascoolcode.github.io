---
// Files
import '/src/global.css';
import favicon from '/favicon.ico';
import { KnownAgents } from "@knownagents/sdk"

// Interface
interface Props {
  	title: string;
}

// Constants
const { title, frontmatter } = Astro.props;
const knownAgents = new KnownAgents("420e1fea-7931-4160-9fd6-bf87899f72fb");

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---
<!doctype html>
<html lang="en">
	<head>
		<!-- Meta -->
		<meta charset="UTF-8" />
		<meta name="description" content="MMDungeon is a blog and archive for artist Mortalmutt."/>
		<meta name="generator" content={Astro.generator} />
		<meta name="viewport" content="width=device-width" />
		<meta name="keywords" content="Mortalmutt, mmdungeon" />
		
		<!-- Scripts -->
		<script src="../assets/lib/js/no_click.js"></script>
		<script src="https://unpkg.com/webamp@1.4.0/built/webamp.bundle.min.js"></script>
		
		<!-- Links -->
		<link rel="icon" type="image/svg+xml" href={favicon}/>
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
		<link rel="alternate" href="/src/feed.xml" type="application/rss+xml" title="RSS">
		
		<!-- Title -->
		<title>MM999 ♱ {title}</title>
	</head>
	<body>
		
		<!-- HEADER -->
		<header class="topbar flex justify-between align-middle">
			<button class="hamburger" id="hamburgerBtn" aria-label="toggle navigation">☰</button>
			<h1>mmdungeon.xyz</h1>
			<div></div>
		</header>

		<!-- MAIN -->
		<main>
			<slot/>
		</main>

		<!-- ASIDE -->
		<aside class="sidebar text-left" id="sidebar">
			<nav>
				<ul>
					<li><a href="/">Index</a></li>
					<li><a href="/webmistress/">Webmistress</a></li>
					<!-- <li class="collapsible">
						<input type="checkbox" id="offerings">
						<label for="offerings">Offerings</label>	
						<ul class="sub-menu">
							<li><a href="">Relics</a></li>
						</ul>
					</li> -->
					<li><a href="/toybox/">Toybox</a></li>
					<li><a href="https://mortalmutt999.tumblr.com/" target="_blank" rel="noopener noreferrer">Diary</a></li>
				</ul>
			</nav>
			<div>
				<div id="statuscafe" class="py-3 text-fg text-xs"><div id="statuscafe-username"></div><div id="statuscafe-content"></div></div><script src="https://status.cafe/current-status.js?name=mortalmutt" defer></script>
				<div> <a href="https://www.mabsland.com/Adoption.html" target="_blank" rel="noopener noreferrer"><img src="https://www.mabsland.com/Pandas/Censor_NC17a.gif" class="m-auto" alt=""></a> </div>
				<small>© MORTALMUTT999</small>
				<div class="py-6" id="contain_moon"><div><div style="filter:drop-shadow(0 0 18px hsl(298,100%,28%))"></div><div></div><div></div></div><script>(function(){var d=new Date().getDate();var m=document.querySelectorAll("#contain_moon div");var a=new XMLHttpRequest();var url="https://www.icalendar37.net/lunar/api/?lang=en&month="+(new Date().getMonth()+1)+"&year="+(new Date().getFullYear())+"&size=20&lightColor=rgb(211,183,227)&shadeColor=rgb(0,0,0)&LDZ="+new Date(new Date().getFullYear(),new Date().getMonth(),1)/1000+"";m[1].style.height="60px";a.onreadystatechange=function(){if(a.readyState==4&&a.status==200){var b=JSON.parse(a.responseText);m[1].innerHTML=b.phase[d].svg;if(typeof moon_widget_loaded=="function")moon_widget_loaded(b)}};a.open("GET",url,true);a.send()})()</script></div>
			</div>
		</aside>
	</body>
</html>

<style>

/* Hide the checkboxes */
.collapsible input {
    display: none;
}

/* Hide the sub-menu by default */
.sub-menu {
    display: none;
    padding-left: 20px;
}

/* Show sub-menu when checkbox is checked */
.collapsible input:checked ~ .sub-menu {
    display: block;
}

/* Style the labels as clickable headers */
.collapsible label {
    cursor: pointer;
    display: block;
}

  /* ----- TOP BAR (fixed, contains hamburger + title) ----- */
  .topbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100px;
    background-color: #000000;
    border-bottom: 1px solid #2a2a2a;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0 1rem;
    z-index: 1000;
    box-shadow: 0 1px 0 #1a1a1a;
  }

  /* ----- HAMBURGER BUTTON ----- */
  .hamburger {
    background: transparent;
    font-size: 1.4rem;
    cursor: pointer;
    transition: all 0.15s ease;
  }
  .hamburger:active {
    transform: scale(0.96);
  }

  /* ----- SIDEBAR (navigation only) ----- */
  .sidebar {
    width: 220px;
    background-color: #000000;
    border-right: 1px solid #2a2a2a;
    padding: 1.5rem 1rem 2rem 1rem;
    position: fixed;
    top: 100px;
    left: 0;
    bottom: 0;
    height: calc(100vh - 100px);
    box-shadow: inset -1px 0 0 #1e1e1e;
    z-index: 900;
    transform: translateX(0);
    transition: transform 0.25s ease;
  }

  .sidebar.collapsed {
    transform: translateX(-100%);
  }

  main {
	margin-top: 100px;
  }

  /* ----- RESPONSIVE: MOBILE ----- */
  @media (max-width: 700px) {
    .sidebar {
      width: 100%;
      max-width: 180px;
    }

    .main-content {
      margin-left: 0 !important;
      padding: 5.5rem 1.2rem 2rem 1.2rem;
    }

    .site-title {
      font-size: 1.2rem;
    }
  }

  @media (max-width: 400px) {
    .hamburger {
      font-size: 1.2rem;
      padding: 0.3rem 0.5rem 0.4rem 0.5rem;
    }

    .site-title {
      font-size: 1rem;
    }
  }
</style>


<script>
  (function() {
    const hamburger = document.getElementById('hamburgerBtn');
    const sidebar = document.getElementById('sidebar');
    const mainContent = document.getElementById('mainContent');

    // Set initial state based on screen size
    function setInitialState() {
      if (window.innerWidth <= 700) {
        sidebar.classList.add('collapsed');
        mainContent.classList.remove('expanded');
      } else {
        sidebar.classList.remove('collapsed');
        mainContent.classList.remove('expanded');
      }
    }

    // Toggle sidebar
    function toggleSidebar() {
      const isCollapsed = sidebar.classList.toggle('collapsed');
      if (window.innerWidth > 700) {
        mainContent.classList.toggle('expanded', isCollapsed);
      } else {
        mainContent.classList.remove('expanded');
      }
    }

    // Hamburger click
    hamburger.addEventListener('click', function(e) {
      e.stopPropagation();
      toggleSidebar();
    });

    // Close sidebar on mobile when a nav link is clicked
    const navLinks = document.querySelectorAll('.nav-links a');
    navLinks.forEach(link => {
      link.addEventListener('click', function() {
        if (window.innerWidth <= 700) {
          sidebar.classList.add('collapsed');
          mainContent.classList.remove('expanded');
        }
      });
    });

    // Handle resize
    window.addEventListener('resize', function() {
      if (window.innerWidth > 700) {
        if (!sidebar.classList.contains('collapsed')) {
          mainContent.classList.remove('expanded');
        } else {
          mainContent.classList.add('expanded');
        }
      } else {
        mainContent.classList.remove('expanded');
      }
    });

    setInitialState();
  })();
</script>
